<Window x:Class="Flow.Launcher.Plugin.RemoteDesktop.Settings.UserOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:Flow.Launcher.Plugin.RemoteDesktop.Settings"
        xmlns:behaviors="clr-namespace:Flow.Launcher.Plugin.RemoteDesktop.Behaviors"
        xmlns:conveters="clr-namespace:Flow.Launcher.Plugin.RemoteDesktop.Converters"
        Width="550"
        Background="{DynamicResource PopupBGColor}"
        Foreground="{DynamicResource PopupTextColor}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settings:UserOverrideViewModel+Design, IsDesignTimeCreatable=True}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <settings:LocalizationManager x:Key="Localization" />
        <conveters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="4"
                            Click="OnCancelClick"
                            Style="{StaticResource TitleBarCloseButtonStyle}">
                        <Path Width="46"
                              Height="32"
                              Data="M 18,11 27,20 M 18,20 27,11"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                            Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Margin="26 12 26 0">
                <Grid>
                    <StackPanel>
                        <StackPanel Margin="0 0 0 12">
                            <TextBlock Margin="0 0 0 0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding UserOverrideDialogTitle, Source={StaticResource Localization}}"
                                       TextAlignment="Left" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       Text="{Binding UserOverrideDialogGuide, Source={StaticResource Localization}}"
                                       TextAlignment="Left"
                                       TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="500">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="10 10 15 10"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{Binding RegexFieldLabel, Source={StaticResource Localization}}" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="10"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Text="{Binding Regex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         behaviors:TextBoxBehavior.Placeholder="{Binding RegexExample, Source={StaticResource Localization}}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="10 10 15 10"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{Binding UserFieldLabel, Source={StaticResource Localization}}" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="10"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Text="{Binding User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehavior.Placeholder="{Binding UserExample, Source={StaticResource Localization}}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PopupButtonAreaBGColor}"
                BorderBrush="{StaticResource PopupButtonAreaBorderColor}"
                BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button MinWidth="140"
                        Margin="10 0 5 0"
                        Content="Cancel"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button MinWidth="140"
                        Margin="5 0 10 0"
                        Content="Confirm"
                        IsDefault="True"
                        IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}"
                        Click="OnConfirmClick"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
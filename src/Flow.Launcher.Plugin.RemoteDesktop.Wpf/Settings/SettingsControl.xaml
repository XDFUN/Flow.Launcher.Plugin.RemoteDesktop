<UserControl x:Class="Flow.Launcher.Plugin.RemoteDesktop.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Flow.Launcher.Plugin.RemoteDesktop.Behaviors"
             xmlns:settings="clr-namespace:Flow.Launcher.Plugin.RemoteDesktop.Settings"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel+Design, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <settings:LocalizationManager x:Key="Localization" />
    </UserControl.Resources>
    <Grid Margin="{StaticResource SettingPanelMargin}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
            FontSize="14"
            Text="{Binding DefaultUserFieldLabel, Source={StaticResource Localization}}" />
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
                 Text="{Binding DefaultUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 behaviors:TextBoxBehavior.Placeholder="{Binding SystemUserHint, Source={StaticResource Localization}}" />

        <!-- MaxHeight="385" for 1 header + 10 rows, each height 35 -->
        <ListView Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding UserOverrides}"
                  Style="{StaticResource {x:Static GridView.GridViewStyleKey}}"
                  Margin="{StaticResource SettingPanelItemTopBottomMargin}"
                  MaxHeight="385"
                  AllowDrop="True"
                  BorderBrush="DarkGray"
                  BorderThickness="1"
                  behaviors:ListViewSelectedItemsBehavior.BindableSelectedItems="{Binding SelectedOverrides}"
                  MouseDoubleClick="OverrideList_MouseDoubleClickItem"
                  PreviewMouseLeftButtonDown="OverrideList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="OverrideList_PreviewMouseMove"
                  Drop="OverrideList_Drop"
                  SizeChanged="OverrideList_SizeChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{Binding RegexHeader, Source={StaticResource Localization}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type settings:UserOverrideViewModel}">
                                <TextBlock Margin="0 6" Text="{Binding Regex}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding UserHeader, Source={StaticResource Localization}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type settings:UserOverrideViewModel}">
                                <TextBlock Margin="0 6" Text="{Binding User}"
                                           behaviors:TextBlockBehavior.Placeholder="{Binding DefaultUserHint, Source={StaticResource Localization}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <!-- The border adds 2 pixel, we just remove them from the header -->
                            <Setter Property="Height" Value="33" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="{StaticResource SettingPanelItemTopBottomMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding DeleteOverride, Source={StaticResource Localization}}"
                    Command="{Binding DeleteOverridesCommand}" />
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding EditOverride, Source={StaticResource Localization}}"
                    Command="{Binding EditOverrideCommand}" />
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding AddOverride, Source={StaticResource Localization}}"
                    Command="{Binding AddOverrideCommand}" />
        </StackPanel>

        <Separator Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="2" Style="{StaticResource SettingPanelSeparatorStyle}" />

        <!-- Aliases List -->
        <ListView Grid.Row="4"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding Aliases}"
                  Style="{StaticResource {x:Static GridView.GridViewStyleKey}}"
                  Margin="{StaticResource SettingPanelItemTopBottomMargin}"
                  MaxHeight="385"
                  AllowDrop="True"
                  BorderBrush="DarkGray"
                  BorderThickness="1"
                  behaviors:ListViewSelectedItemsBehavior.BindableSelectedItems="{Binding SelectedAliases}"
                  MouseDoubleClick="AliasList_MouseDoubleClickItem"
                  PreviewMouseLeftButtonDown="AliasList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="AliasList_PreviewMouseMove"
                  Drop="AliasList_Drop"
                  SizeChanged="AliasList_SizeChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{Binding AliasHeader, Source={StaticResource Localization}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type settings:AliasViewModel}">
                                <TextBlock Margin="0 6" Text="{Binding Alias}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{Binding HostHeader, Source={StaticResource Localization}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type settings:AliasViewModel}">
                                <TextBlock Margin="0 6" Text="{Binding Host}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <!-- The border adds 2 pixel, we just remove them from the header -->
                            <Setter Property="Height" Value="33" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="{StaticResource SettingPanelItemTopBottomMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding DeleteAlias, Source={StaticResource Localization}}"
                    Command="{Binding DeleteAliasesCommand}" />
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding EditAlias, Source={StaticResource Localization}}"
                    Command="{Binding EditAliasCommand}" />
            <Button Width="100"
                    Margin="{StaticResource SettingPanelItemLeftMargin}"
                    Content="{Binding AddAlias, Source={StaticResource Localization}}"
                    Command="{Binding AddAliasCommand}" />
        </StackPanel>

        <Separator Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="2" Style="{StaticResource SettingPanelSeparatorStyle}" />

        <Button Grid.Row="7"
                Grid.Column="0"
                Margin="{StaticResource SettingPanelItemTopBottomMargin}"
                Content="{Binding Save, Source={StaticResource Localization}}"
                Command="{Binding SaveCommand}" />
    </Grid>
</UserControl>